# The developer's private notes beside AGENTS.md. Never committed (NOCTUA.md §3.4).
AGENTS.local.md

# Build output.
/target/

# The pre-rendered documentation site.
#
# Not committed: it is 83 files and about 5 MB of copied palette stylesheets,
# all of it reproducible by `cargo xtask docs` from sources that ARE committed.
# A generated artifact belongs in the repository only when something downstream
# cannot regenerate it — the token output qualifies, a whole website does not.
/docs-site/dist/

# Node, for the React package and the conformance runner.
node_modules/

# The bundled React examples.
#
# Not committed, unlike the generated token output. That output IS this
# repository's spec compiled, and committing it is what lets a consumer take a
# dependency with no build step. This is 270 KB of minified third-party React
# with an interpreter inside it — nobody reviews that in a diff, and one command
# reproduces it:
#
#     pnpm --filter @noctua-world/docs-site run build:example
#
# `cargo xtask docs` notes its absence and carries on, so a Rust-only clone still
# builds the whole site; only the implementation switch is inert.
/docs-site/assets/react/

# Playwright's own output.
/test-results/
/playwright-report/

# Throwaway measuring scripts.
#
# A probe has to live inside the repository to resolve `@playwright/test`, and
# every one written so far was dropped in the root and deleted by hand — which
# is a step that gets forgotten and a stray `shot.mjs` that gets committed.
# One ignored directory instead.
/probe/

# The example consumers build outside this workspace, so `/target` above does
# not cover them, and their lockfiles are a consumer's business rather than
# this repository's.
/examples/*/target/
/examples/*/Cargo.lock
