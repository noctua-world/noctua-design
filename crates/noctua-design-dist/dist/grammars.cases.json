    },
    {
      "language": "yaml",
      "name": "a key is a property and a scalar is not",
      "code": "name: noctua\nsteps:\n  - 1\n  - 2",
      "expect": ["property name", "plain noctua", "property steps", "number 1"],
      "reject": []
    },
    {
      "language": "yaml",
      "name": "a quoted key is still a key",
      "code": "\"on\": true",
      "expect": ["property \"on\"", "constant true"],
      "reject": []
    },
    {
      "language": "yaml",
      "name": "a comment is a comment and a hash in a value is not",
