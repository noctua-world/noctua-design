{
  "name": "@noctua-world/docs-site",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "The documentation site's client-side module. The pages themselves are pre-rendered by the Rust binary in src/.",
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@noctua-world/design-react": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:example": "esbuild js/example-react.js --bundle --format=esm --minify --splitting --outdir=assets/react --entry-names=[name] --chunk-names=[name]-[hash] --define:process.env.NODE_ENV=\\\"production\\\" --metafile=assets/react/meta.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
