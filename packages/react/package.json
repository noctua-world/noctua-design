{
  "name": "@noctua-world/design-react",
  "version": "0.2.2",
  "type": "module",
  "description": "The Noctua design system, as React components. ThemeScope is generated from spec/theme.toml.",
  "license": "MIT OR Apache-2.0",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@noctua-world/design-tokens": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./theme.js": {
      "types": "./src/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./components/index.js": {
      "types": "./src/components/index.d.ts",
      "default": "./src/components/index.js"
    },
    "./components/*.js": {
      "types": "./src/components/*.d.ts",
      "default": "./src/components/*.js"
    }
  },
  "files": [
    "src",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ]
}
